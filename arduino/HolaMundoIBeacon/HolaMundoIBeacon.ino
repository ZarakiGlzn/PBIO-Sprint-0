inline void lucecitas() {
  using namespace Globales;

  elLED.brillar( 100 ); // 100 encendido
  esperar ( 400 ); //  100 apagado
  elLED.brillar( 100 ); // 100 encendido
  esperar ( 400 ); //  100 apagado
  Globales::elLED.brillar( 100 ); // 100 encendido
  esperar ( 400 ); //  100 apagado
  Globales::elLED.brillar( 1000 ); // 1000 encendido
  esperar ( 1000 ); //  100 apagado
} // ()

// --------------------------------------------------------------
// loop ()
// --------------------------------------------------------------
namespace Loop {
  uint8_t cont = 0;
};

// ..............................................................
// ..............................................................
void loop () {

  using namespace Loop;
  using namespace Globales;

  cont++;

  elPuerto.escribir( "\n---- loop(): empieza " );
  elPuerto.escribir( cont );
  elPuerto.escribir( "\n" );


  lucecitas();

  // 
  // mido y publico
  // 
  int valorCO2 = elMedidor.medirCO2();
  
  elPublicador.publicarCO2( valorCO2,
							cont,
							1000 // intervalo de emisión
							);
  
  // 
  // mido y publico
  // 
  int valorTemperatura = elMedidor.medirTemperatura();
  
  elPublicador.publicarTemperatura( valorTemperatura, 
									cont,
									1000 // intervalo de emisión
									);

  // ========================================================================
  // ¡AQUÍ PUEDES CAMBIAR EL VALOR DE LA MEDIDA DE EJEMPLO!
  // ========================================================================
  uint16_t valorOzonoMedido = 4321; // Modifica este número por el que quieras probar
  // ========================================================================

  char datos[21] = {
	'E', 'P', 'S', 'G', '-', 'G', 'T', 'I',
	'-', 'P', 'R', 'O', 'Y', '-', '3', 'A',
	0x00, 0x0B,
	(char)((valorOzonoMedido >> 8) & 0xFF), // Byte alto de la medida
	(char)(valorOzonoMedido & 0xFF),        // Byte bajo de la medida
	(char)-54
  };

  elPublicador.laEmisora.emitirAnuncioIBeaconLibre ( &datos[0], 21 );

  esperar( 2000 );

  elPublicador.laEmisora.detenerAnuncio();
  
  // 
  // 
  // 
  elPuerto.escribir( "---- loop(): acaba **** " );
  elPuerto.escribir( cont );
  elPuerto.escribir( "\n" );
  
} // loop ()
